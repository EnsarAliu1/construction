{
  "name": "fitimi-construction",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check:routes": "node scripts/check-routes.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "test": "tsx --test tests/db/config.test.ts tests/db/schema.test.ts tests/db/history.test.ts tests/auth/security.test.ts tests/clients/validation.test.ts tests/projects/validation.test.ts tests/references/validation.test.ts tests/expenses/validation.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/db/integrity.integration.test.ts tests/auth/auth.integration.test.ts tests/clients/clients.integration.test.ts tests/projects/projects.integration.test.ts tests/references/references.integration.test.ts tests/expenses/expenses.integration.test.ts",
    "test:references": "tsx --test tests/references/validation.test.ts",
    "test:references:db": "tsx --test tests/references/references.integration.test.ts",
    "test:references:http": "tsx --test tests/references/http.integration.test.ts",
    "test:projects": "tsx --test tests/projects/validation.test.ts",
    "test:projects:db": "tsx --test tests/projects/projects.integration.test.ts",
    "test:projects:http": "tsx --test tests/projects/http.integration.test.ts",
    "test:clients": "tsx --test tests/clients/validation.test.ts",
    "test:clients:db": "tsx --test tests/clients/clients.integration.test.ts",
    "test:clients:http": "tsx --test tests/clients/http.integration.test.ts",
    "test:auth": "tsx --test tests/auth/security.test.ts",
    "test:auth:http": "tsx --test tests/auth/http.integration.test.ts",
    "accounts": "tsx scripts/accounts.ts",
    "test:expenses": "tsx --test tests/expenses/validation.test.ts",
    "test:expenses:db": "tsx --test tests/expenses/expenses.integration.test.ts",
    "test:expenses:http": "tsx --test tests/expenses/http.integration.test.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "mysql2": "3.24.6",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}

{
  "name": "fitimi-construction",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --import tsx scripts/development/dev.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check:routes": "node scripts/check-routes.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "test": "tsx --test tests/website/content.test.ts tests/i18n/albanian.test.ts tests/security/headers.test.ts tests/security/recovery-key.test.ts tests/security/password.test.ts tests/release/events.test.ts tests/release/password-screen.test.ts tests/auth/mfa-crypto.test.ts tests/auth/passkeys.test.ts && node --conditions=react-server --import tsx --test tests/reporting/validation.test.ts && tsx --test tests/db/config.test.ts tests/db/schema.test.ts tests/db/history.test.ts tests/auth/security.test.ts tests/clients/validation.test.ts tests/projects/validation.test.ts tests/references/validation.test.ts tests/expenses/validation.test.ts tests/payments/validation.test.ts tests/receipts/pdf.test.ts",
    "test:db": "node --conditions=react-server --import tsx --test tests/reporting/reporting.integration.test.ts && tsx --test --test-concurrency=1 tests/db/integrity.integration.test.ts tests/auth/auth.integration.test.ts tests/clients/clients.integration.test.ts tests/projects/projects.integration.test.ts tests/references/references.integration.test.ts tests/expenses/expenses.integration.test.ts tests/payments/payments.integration.test.ts tests/receipts/receipts.integration.test.ts",
    "test:references": "tsx --test tests/references/validation.test.ts",
    "test:references:db": "tsx --test tests/references/references.integration.test.ts",
    "test:references:http": "tsx --test tests/references/http.integration.test.ts",
    "test:projects": "tsx --test tests/projects/validation.test.ts",
    "test:projects:db": "tsx --test tests/projects/projects.integration.test.ts",
    "test:projects:http": "tsx --test tests/projects/http.integration.test.ts",
    "test:clients": "tsx --test tests/clients/validation.test.ts",
    "test:clients:db": "tsx --test tests/clients/clients.integration.test.ts",
    "test:clients:http": "tsx --test tests/clients/http.integration.test.ts",
    "test:auth": "tsx --test tests/auth/security.test.ts",
    "test:auth:http": "tsx --test tests/auth/http.integration.test.ts",
    "accounts": "tsx scripts/accounts.ts",
    "test:expenses": "tsx --test tests/expenses/validation.test.ts",
    "test:expenses:db": "tsx --test tests/expenses/expenses.integration.test.ts",
    "test:expenses:http": "tsx --test tests/expenses/http.integration.test.ts",
    "test:payments": "tsx --test tests/payments/validation.test.ts",
    "test:payments:db": "tsx --test tests/payments/payments.integration.test.ts",
    "test:payments:http": "tsx --test tests/payments/http.integration.test.ts",
    "test:receipts": "tsx --test tests/receipts/pdf.test.ts",
    "test:receipts:db": "tsx --test tests/receipts/receipts.integration.test.ts",
    "test:receipts:http": "tsx --test tests/receipts/http.integration.test.ts",
    "receipts:recover": "tsx scripts/receipts-recover.ts",
    "test:reports": "node --conditions=react-server --import tsx --test tests/reporting/validation.test.ts",
    "test:reports:db": "node --conditions=react-server --import tsx --test tests/reporting/reporting.integration.test.ts",
    "test:reports:http": "node --conditions=react-server --import tsx --test tests/reporting/http.integration.test.ts",
    "test:website": "tsx --test tests/website/content.test.ts",
    "test:website:db": "tsx --test tests/website/isolation.integration.test.ts",
    "test:website:browser": "playwright test",
    "perf:lab": "node --conditions=react-server --import tsx scripts/performance/measure.ts",
    "test:security:race": "tsx --test tests/security/download-race.integration.test.ts",
    "test:security:http": "node scripts/security/inventory.mjs && node --conditions=react-server --import tsx --test tests/security/http.integration.test.ts",
    "test:security:browser": "node --conditions=react-server --import tsx scripts/security/browser.ts",
    "test:security:db": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/security/download-race.integration.test.ts tests/security/runtime-role.integration.test.ts",
    "test:security": "tsx --test tests/security/headers.test.ts tests/security/recovery-key.test.ts tests/security/password.test.ts",
    "security:scan": "tsx scripts/security/scan.ts",
    "test:security:recovery": "node --conditions=react-server --import tsx scripts/security/browser-recovery.ts",
    "test:release:restore": "node --conditions=react-server --import tsx scripts/release/restore-drill.ts",
    "test:release": "tsx --test tests/release/events.test.ts tests/release/password-screen.test.ts",
    "test:release:browser": "node --conditions=react-server --import tsx scripts/release/business-browser.ts",
    "test:mfa": "tsx --test tests/auth/mfa-crypto.test.ts",
    "test:mfa:db": "tsx --test tests/auth/mfa.integration.test.ts",
    "test:mfa:browser": "node --conditions=react-server --import tsx scripts/mfa/browser.ts",
    "test:mfa:http": "node --conditions=react-server --import tsx --test tests/auth/mfa-http.integration.test.ts",
    "perf:mfa": "node --conditions=react-server --import tsx scripts/mfa/benchmark.ts",
    "dev:setup": "node scripts/development/setup.mjs",
    "test:passkeys:local": "node scripts/passkeys/local-test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "mysql2": "3.24.6",
    "next": "16.4.3",
    "otpauth": "9.5.2",
    "pdfkit": "0.20.2",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}

# Local disposable MySQL 8.4 only. Copy to .env.local and fill locally.
# Never commit populated URLs or use a production database.
DATABASE_URL=
TEST_DATABASE_URL=
# Required opt-in for migration and integration-test database access.
DATABASE_DISPOSABLE=0
# Trusted externally visible origin. Production requires HTTPS.
AUTH_ORIGIN=http://127.0.0.1:3000
# Private random operator key, minimum 32 characters. CLI only; never NEXT_PUBLIC.
ADORE_OPERATOR_KEY=
# Test only: exact task-owned container ID; enables guarded pause/resume outage test.
AUTH_TEST_CONTAINER_ID=
# Expected ownership label for HTTP outage tests: WP-03 (default), WP-04, WP-05, WP-06, WP-07, WP-08, WP-09, WP-10 or WP-11.
AUTH_TEST_WORK_PACKAGE=WP-03

# Server-only private PDF store. Never use public/, .next/, or a shared/synced public folder.
# Default is .private/receipts under the workspace; Windows NTFS permissions are restricted automatically.
# Each store binds to one MySQL server UUID/database. Use distinct stores for separate databases.
RECEIPT_STORAGE_DIR=
# Approved real company display name; blank displays DEVELOPMENT ONLY, never invented legal details.
RECEIPT_COMPANY_NAME=
# Optional deployment-owned receipt/report presentation. Never invent legal company data.
RECEIPT_COMPANY_ADDRESS=
RECEIPT_COMPANY_CITY=
RECEIPT_COMPANY_NUI=
RECEIPT_COMPANY_PHONE=
RECEIPT_COMPANY_EMAIL=
RECEIPT_COMPANY_BANK=
RECEIPT_COMPANY_IBAN=
# Logo filename only; must already exist inside public/logos (PNG/JPEG).
RECEIPT_LOGO_FILE=construction.png
# unspecified | not-registered | registered. A receipt is not a tax invoice.
# Registered requires the VAT number + an explicit rate (18, 8 or 0).
# Rate 0 also requires an accountant-approved explanation in RECEIPT_VAT_NOTE.
RECEIPT_VAT_STATUS=unspecified
RECEIPT_VAT_NUMBER=
RECEIPT_VAT_RATE=
RECEIPT_VAT_NOTE=
# Development non-fiscal format. Company-wide monotonic sequence is independent of this display prefix.
# Accounting approval is required before real use; changing prefix never resets the counter.
RECEIPT_NUMBER_PREFIX=DEV

# Optional approved public origin. No canonical domain is invented when blank.
PUBLIC_SITE_URL=
# Enable only after domain/content/privacy approvals. Staging remains noindex by default.
PUBLIC_SITE_INDEXING=0

# Mandatory MFA: generated 32-byte keys, kept in a separate production vault/key store.
# JSON object mapping key IDs to base64 keys; no default/test value is safe for production.
# Keep old IDs available until every factor has been deliberately re-encrypted.
MFA_ENCRYPTION_KEY_ID=
MFA_ENCRYPTION_KEYS=

# Optional link to a separately isolated demo deployment. Never put DEMO_MODE=1 in the real app.
# npm run dev starts the dedicated local demo at http://localhost:3001 automatically.
DEMO_ORIGIN=

# Local disposable MySQL 8.4 only. Copy to .env.local and fill locally.
# Never commit populated URLs or use a production database.
DATABASE_URL=
TEST_DATABASE_URL=
# Required opt-in for migration and integration-test database access.
DATABASE_DISPOSABLE=0
# Trusted externally visible origin. Production requires HTTPS.
AUTH_ORIGIN=http://127.0.0.1:3000
# Private random operator key, minimum 32 characters. CLI only; never NEXT_PUBLIC.
ADORE_OPERATOR_KEY=
# Test only: exact owned WP-03 container ID; enables guarded pause/resume outage test.
AUTH_TEST_CONTAINER_ID=

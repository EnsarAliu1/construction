{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-wp09/types/**/*.ts",
    ".next-wp09/dev/types/**/*.ts",
    ".next-wp10/types/**/*.ts",
    ".next-wp10/dev/types/**/*.ts",
    ".next-wp11/types/**/*.ts",
    ".next-wp11/dev/types/**/*.ts",
    ".next-wp13/types/**/*.ts",
    ".next-wp13/dev/types/**/*.ts",
    ".next-wp14/types/**/*.ts",
    ".next-wp14/dev/types/**/*.ts",
    ".next-wp15/types/**/*.ts",
    ".next-wp15/dev/types/**/*.ts",
    ".next-wp16/types/**/*.ts",
    ".next-wp16/dev/types/**/*.ts",
    ".next-sq/types/**/*.ts",
    ".next-sq/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "artifacts"
  ]
}
